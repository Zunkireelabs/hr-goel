<section class="page-hero">
  <div class="page-hero-media" style="background-image:url('/assets/projects/road.jpg')" aria-hidden="true"></div>
  <div class="page-hero-overlay" aria-hidden="true"></div>
  <div class="wrap">
    <h1>Quantity Calculators</h1>
    <p>Quick estimates for planning your material order. Final quantities should be confirmed with our technical team.</p>
  </div>
</section>

<section class="section-tight-top">
  <div class="wrap grid grid-2 calc-grid">
    <div class="card calc-card">
      <div class="dl-card-head">
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3s6 6.5 6 11a6 6 0 1 1-12 0c0-4.5 6-11 6-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
        <div><h3>Bitumen calculator</h3><p class="muted">Estimates bitumen needed for road surfacing.</p></div>
      </div>
      <div class="form" style="grid-template-columns:1fr;">
        <div><label for="b-area">Road area (m²)</label><input id="b-area" type="number" min="0" value="1000"></div>
        <div><label for="b-rate">Application rate (kg/m²)</label><input id="b-rate" type="number" min="0" step="0.1" value="1.2"></div>
        <div class="full calc-result"><span class="calc-result-label">Estimated bitumen needed</span><span class="calc-result-value"><span id="b-result">1200</span> kg</span></div>
      </div>
    </div>

    <div class="card calc-card">
      <div class="dl-card-head">
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3v6m0 0-3 3m3-3 3 3M5 21h14M7 21v-4a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <div><h3>Admixture calculator</h3><p class="muted">Estimates admixture dosage based on cement quantity.</p></div>
      </div>
      <div class="form" style="grid-template-columns:1fr;">
        <div><label for="a-cement">Cement quantity (kg)</label><input id="a-cement" type="number" min="0" value="500"></div>
        <div><label for="a-dose">Dosage (% of cement weight)</label><input id="a-dose" type="number" min="0" step="0.1" value="1.5"></div>
        <div class="full calc-result"><span class="calc-result-label">Estimated admixture needed</span><span class="calc-result-value"><span id="a-result">7.5</span> kg</span></div>
      </div>
    </div>

    <div class="card calc-card">
      <div class="dl-card-head">
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 10.5c0-1.4 1.3-2.5 3-2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <div><h3>Waterproofing calculator</h3><p class="muted">Estimates coating needed for a given surface area.</p></div>
      </div>
      <div class="form" style="grid-template-columns:1fr;">
        <div><label for="w-area">Surface area (m²)</label><input id="w-area" type="number" min="0" value="100"></div>
        <div><label for="w-rate">Coverage rate (m² per litre)</label><input id="w-rate" type="number" min="0.1" step="0.1" value="1.5"></div>
        <div class="full calc-result"><span class="calc-result-label">Estimated coating needed</span><span class="calc-result-value"><span id="w-result">66.67</span> litres</span></div>
      </div>
    </div>

    <div class="card calc-card">
      <div class="dl-card-head">
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M4 14h16M4 9h16" stroke="currentColor" stroke-width="1.7"/></svg></span>
        <div><h3>Flooring calculator</h3><p class="muted">Estimates material volume for industrial flooring.</p></div>
      </div>
      <div class="form" style="grid-template-columns:1fr;">
        <div><label for="f-area">Floor area (m²)</label><input id="f-area" type="number" min="0" value="200"></div>
        <div><label for="f-thickness">Thickness (mm)</label><input id="f-thickness" type="number" min="0" step="0.5" value="5"></div>
        <div class="full calc-result"><span class="calc-result-label">Estimated material volume</span><span class="calc-result-value"><span id="f-result">1</span> m³</span></div>
      </div>
    </div>
  </div>
</section>

{% include "enquiry-cta.njk" %}

<script>
  function bindCalc(ids, calcFn) {
    const inputs = ids.inputs.map(id => document.getElementById(id));
    const result = document.getElementById(ids.result);
    function update() {
      const vals = inputs.map(el => parseFloat(el.value) || 0);
      result.textContent = calcFn(...vals);
    }
    inputs.forEach(el => el.addEventListener('input', update));
    update();
  }

  bindCalc({ inputs: ['b-area', 'b-rate'], result: 'b-result' }, (area, rate) => Math.round(area * rate));
  bindCalc({ inputs: ['a-cement', 'a-dose'], result: 'a-result' }, (cement, dose) => (cement * dose / 100).toFixed(2));
  bindCalc({ inputs: ['w-area', 'w-rate'], result: 'w-result' }, (area, rate) => rate > 0 ? (area / rate).toFixed(2) : '0');
  bindCalc({ inputs: ['f-area', 'f-thickness'], result: 'f-result' }, (area, thickness) => ((area * thickness) / 1000).toFixed(2));
</script>
