---
layout: base.njk
title: Contact
permalink: /contact/
---
<section class="page-hero">
  <div class="page-hero-media" style="background-image:url('/assets/hero-building-wide.jpg')" aria-hidden="true"></div>
  <div class="page-hero-overlay" aria-hidden="true"></div>
  <div class="wrap">
    <h1>Contact us</h1>
    <p>Reach our team, find your nearest branch, or request a quotation.</p>
    <div class="page-hero-stats">
      <div class="page-hero-stat"><span class="num">24h</span><span class="sub">Typical response time</span></div>
      <div class="page-hero-stat"><span class="num">{{ site.branches.length }}<span class="plus">+</span></span><span class="sub">Branches nationwide</span></div>
      <div class="page-hero-stat"><span class="num">40<span class="plus">+</span></span><span class="sub">Years of experience</span></div>
    </div>
  </div>
</section>

<section class="section-white section-tight-top hrgg-section" style="border-top:none; padding-top:26px;">
  <div class="wrap">
    <div class="grid grid-3 hrgg-grid">
      <div class="hrgg-card">
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 5c0-1.1.9-2 2-2h2.2c.5 0 .9.3 1 .8l1 3.6c.1.4 0 .9-.4 1.2L8.4 10c1 2.4 2.8 4.4 5.2 5.4l1.4-1.4c.3-.3.8-.4 1.2-.3l3.5 1c.5.1.8.6.8 1.1V19c0 1.1-.9 2-2 2h-1C9.6 21 3 14.4 3 6.2V5.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
        <h3>Call us</h3>
        {% for p in site.phone %}<p><a href="tel:{{ p }}">{{ p }}</a></p>{% endfor %}
      </div>
      <div class="hrgg-card">
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <h3>Email us</h3>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>
      <div class="hrgg-card hrgg-card--accent">
        <span class="hrgg-card-badge">Fastest reply</span>
        <span class="hrgg-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.5 9.5c0 3.5 2.5 6 6 6l1-2-2.5-1-1 1c-1-.5-2-1.5-2.5-2.5l1-1-1-2.5-1.5.5Z" fill="currentColor"/></svg></span>
        <h3>WhatsApp</h3>
        <p><a class="btn btn-primary" href="{{ site.whatsapp }}" target="_blank" rel="noopener">Chat with us</a></p>
      </div>
    </div>
  </div>
</section>

<section class="section-alt branches-section" id="branches">
  <div class="wrap">
    <h2>Our branches</h2>
    <p class="section-lead">An interactive dealer/branch locator map is planned for a later phase — for now, here's our full branch list.</p>
    <div class="grid grid-3 branches-grid">
      {% for b in site.branches %}
      <div class="branch-card{% if loop.first %} branch-card--hq{% endif %}">
        <span class="branch-card-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.7"/></svg>
        </span>
        <div>
          {% if loop.first %}<span class="branch-card-tag">Head office</span>{% endif %}
          <p>{{ b }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% include "enquiry-cta.njk" %}
