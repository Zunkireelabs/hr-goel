server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml;

    # CRM quote-form proxy: adds the API key server-side (CRM_API_KEY env var)
    location = /api/get-a-quote {
        limit_except POST { deny all; }
        client_max_body_size 16k;

        resolver 127.0.0.11 valid=30s;
        set $crm_upstream "https://dev-lead-crm.zunkireelabs.com/api/public/submit/hr-goel-group/get-a-quote";

        proxy_pass $crm_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host dev-lead-crm.zunkireelabs.com;
        proxy_set_header Origin "https://hr-goel.zunkireelabs.com";
        proxy_set_header Authorization "Bearer ${CRM_API_KEY}";
        proxy_set_header Content-Type "application/json";
        proxy_connect_timeout 10s;
        proxy_read_timeout 20s;
        add_header Cache-Control "no-store" always;
    }

    # Static assets — cache aggressively (Eleventy uses content-hashed filenames)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # HTML pages — no cache (always serve fresh content)
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Sitemap and robots — short cache
    location ~* (sitemap\.xml|robots\.txt)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
    }

    # Static site routing — try exact file, then directory, then .html extension, then index
    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }
}
